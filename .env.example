# Copy to .env.local (gitignored) and fill in from the **evident-dev** project:
# Supabase dashboard → Project Settings → API.
# Local development and Expo Go always point at DEV, never prod.
# Prod values are set as EAS environment variables when production builds start.
# Only the anon/publishable key goes here — NEVER the service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
