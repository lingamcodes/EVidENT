    "@types/react": "~19.3.0",
    "supabase": "^2.118.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "db:link-dev": "supabase link --project-ref",
    "db:push-dev": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "db:seed-dev": "supabase db query --linked -f scripts/dev-seed/seed.sql",
    "db:unseed-dev": "supabase db query --linked -f scripts/dev-seed/unseed.sql",
    "test:dev": "node --env-file=.env.local scripts/dev-seed/persona-tests.cjs"
  },
  "private": true
